From eebefebe6b919127a29b7dee0e59954d84c7ac8e Mon Sep 17 00:00:00 2001
From: Xael South <xael.south@yandex.com>
Date: Fri, 30 Oct 2026 16:44:01 +1300
Subject: [PATCH] imx23-evk: add bit-banged I2C bus with 24c128 EEPROM

The i.MX23 hardware I2C block has no U-Boot driver, so use i2c-gpio on
the I2C_SCL/I2C_SDA pads. The EEPROM matches the Linux device tree.

Signed-off-by: Xael South <xael.south@yandex.com>
Co-authored-by: Copilot <223556219+Copilot@users.noreply.github.com>
---
 arch/arm/dts/imx23-evk.dts  | 17 +++++++++++++++++
 board/nxp/mx23evk/mx23evk.c |  5 +++++
 2 files changed, 22 insertions(+)

diff --git a/arch/arm/dts/imx23-evk.dts b/arch/arm/dts/imx23-evk.dts
index 97cd3a13c01..3d33b913ec2 100644
--- a/arch/arm/dts/imx23-evk.dts
+++ b/arch/arm/dts/imx23-evk.dts
@@ -32,6 +32,23 @@
 		enable-active-high;
 	};
 
+	/* i.MX23 hardware I2C has no U-Boot driver, use bit-banging on the same pads */
+	i2c0: i2c-gpio {
+		compatible = "i2c-gpio";
+		sda-gpios = <&gpio0 31 0>;
+		scl-gpios = <&gpio0 30 0>;
+		i2c-gpio,delay-us = <5>;
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		eeprom@50 {
+			compatible = "atmel,24c128";
+			reg = <0x50>;
+			pagesize = <64>;
+			size = <16384>;
+		};
+	};
+
 	reg_lcd_5v: regulator-lcd-5v {
 		compatible = "regulator-fixed";
 		regulator-name = "lcd-5v";
diff --git a/board/nxp/mx23evk/mx23evk.c b/board/nxp/mx23evk/mx23evk.c
index 9843350579a..5fe072d0d03 100644
--- a/board/nxp/mx23evk/mx23evk.c
+++ b/board/nxp/mx23evk/mx23evk.c
@@ -42,6 +42,11 @@ static const iomux_cfg_t iomux_setup[] = {
 		(MXS_PAD_8MA | MXS_PAD_3V3 | MXS_PAD_NOPULL),
 	MX23_PAD_SSP1_SCK__SSP1_SCK |
 		(MXS_PAD_8MA | MXS_PAD_3V3 | MXS_PAD_NOPULL),
+	/* I2C bus (bit-banged) */
+	MX23_PAD_I2C_SCL__GPIO_0_30 |
+		(MXS_PAD_8MA | MXS_PAD_3V3 | MXS_PAD_PULLUP),
+	MX23_PAD_I2C_SDA__GPIO_0_31 |
+		(MXS_PAD_8MA | MXS_PAD_3V3 | MXS_PAD_PULLUP),
 	/* Write Protect Pin */
 	MX23_PAD_PWM4__GPIO_1_30 |
 		(MXS_PAD_4MA | MXS_PAD_3V3 | MXS_PAD_NOPULL),
-- 
2.43.0

