CONFIG_BOOTCOMMAND="mmc dev ${mmcdev}; if mmc rescan; then if run loadbootscript; then run bootscript; else if run loadimage; then run mmcboot; else echo ERR: Fail to boot from MMC; fi; fi; else setenv itb_loadaddr 0x46000000; echo Try booting from ITB at $itb_loadaddr; setenv bootargs console=$console,$baudrate root=/dev/ram0 rw rootwait=30; bootm $itb_loadaddr; exit; fi"
CONFIG_CMD_GPIO_READ=y
CONFIG_CMD_SETEXPR=y
CONFIG_RTC_MXS=y
CONFIG_CMD_BOOTZ=y
CONFIG_CMD_LSBLK=y
CONFIG_CMD_MEMINFO=y
CONFIG_LEGACY_IMAGE_FORMAT=y
CONFIG_SYS_BOOTM_LEN=0x1000000
CONFIG_SUPPORT_RAW_INITRD=y
CONFIG_SPL_LOAD_FIT_ADDRESS=0x41100000
CONFIG_FIT=y
CONFIG_FIT_PRINT=y
CONFIG_FIT_FULL_CHECK=y
CONFIG_FIT_EXTERNAL_OFFSET=0x0
CONFIG_FIT_VERBOSE=y
CONFIG_SHA1=y
CONFIG_SHA256=y
CONFIG_ENV_IS_NOWHERE=y
CONFIG_CMD_USB_MASS_STORAGE=y
CONFIG_USB=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_GADGET=y
CONFIG_USB_GADGET_MANUFACTURER="FSL"
CONFIG_USB_GADGET_VENDOR_NUM=0x066f
CONFIG_USB_GADGET_PRODUCT_NUM=0x3700
CONFIG_CI_UDC=y
CONFIG_USB_GADGET_DOWNLOAD=y