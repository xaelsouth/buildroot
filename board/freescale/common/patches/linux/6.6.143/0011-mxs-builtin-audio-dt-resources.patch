+	if (mxs_adc->stream_muted || !mxs_adc->dac_sw[0])
+		mute |= BM_AUDIOOUT_DACVOLUME_MUTE_LEFT;
+	if (mxs_adc->stream_muted || !mxs_adc->dac_sw[1])
+		mute |= BM_AUDIOOUT_DACVOLUME_MUTE_RIGHT;
