+/* The register blocks are syscon nodes shared with the codec. */
+static struct regmap *mxs_dai_get_regmap(struct device *dev, const char *prop)
+{
+	struct regmap *map = syscon_regmap_lookup_by_phandle(dev->of_node, prop);
+
+	if (IS_ERR(map))
+		dev_err_probe(dev, PTR_ERR(map), "failed to get %s regmap\n", prop);
+	return map;
+}
+
+/* Look up a named interrupt of the SoC node referenced by @prop */
+static int mxs_dai_get_irq(struct device *dev, const char *prop, const char *name)
+{
+	struct device_node *np;
+	int irq;
+
+	np = of_parse_phandle(dev->of_node, prop, 0);
+	if (!np) {
+		dev_err(dev, "missing %s phandle\n", prop);
+		return -EINVAL;
+	}
+
+	irq = of_irq_get_byname(np, name);
+	of_node_put(np);
+	if (irq == 0)
+		irq = -ENXIO;
+	if (irq < 0)
+		return dev_err_probe(dev, irq, "failed to get %s irq\n", name);
+
+	return irq;
+}
+
