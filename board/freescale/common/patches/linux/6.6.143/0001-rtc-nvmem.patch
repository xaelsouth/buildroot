+};
+
+static const struct nvmem_keepout stmp3xxx_rtc_nvram_keepout[] = {
+	{
+		.start = STMP3XXX_RTC_CTRL,
+		.end = STMP3XXX_RTC_PERSISTENT0
+	}, {
+		.start = STMP3XXX_RTC_PERSISTENT0 + STMP_OFFSET_REG_SET,
+		.end = STMP3XXX_RTC_PERSISTENT1
+	}, {
+		.start = STMP3XXX_RTC_PERSISTENT1 + STMP_OFFSET_REG_SET,
+		.end = STMP3XXX_RTC_PERSISTENT2
+	}, {
+		.start = STMP3XXX_RTC_PERSISTENT2 + STMP_OFFSET_REG_SET,
+		.end = STMP3XXX_RTC_PERSISTENT3
