+
+static int stmp3xxx_rtc_nvram_read(void *priv, unsigned int offset,
+					void *val, size_t bytes)
+{
+	struct stmp3xxx_rtc_data *rtc_data = priv;
+	u32 *buf = val;
+
+	spin_lock_irq(&rtc_data->nvram_lock);
+
+	while (bytes) {
+		*buf++ = readl(rtc_data->io + offset);
+		bytes -= 4;
+		offset += 4;
+	}
+
+	spin_unlock_irq(&rtc_data->nvram_lock);
+
+	return 0;
+}
+
+static int stmp3xxx_rtc_nvram_write(void *priv, unsigned int offset,
+					void *val, size_t bytes)
+{
+	struct stmp3xxx_rtc_data *rtc_data = priv;
+	const u32 *buf = val;
+
+	spin_lock_irq(&rtc_data->nvram_lock);
+
+	while (bytes) {
+		writel(*buf++, rtc_data->io + offset);
+		bytes -= 4;
+		offset += 4;
+	}
+
+	spin_unlock_irq(&rtc_data->nvram_lock);
+
+	return 0;
 }
 
