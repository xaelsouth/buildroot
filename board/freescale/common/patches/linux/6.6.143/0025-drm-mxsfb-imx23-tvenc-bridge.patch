@@ -0,0 +1,36 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/*
+ * i.MX23 TV encoder (TVENC) DRM bridge.
+ */
+
+#ifndef __MXSFB_TVENC_H__
+#define __MXSFB_TVENC_H__
+
+#include <linux/errno.h>
+#include <linux/platform_device.h>
+
+struct drm_bridge;
+
+enum mxsfb_tv_standard {
+	MXSFB_TV_PAL,
+	MXSFB_TV_NTSC,
+};
+
+#if IS_ENABLED(CONFIG_DRM_MXSFB_TVENC)
+extern struct platform_driver mxsfb_tvenc_driver;
+bool mxsfb_bridge_is_tvenc(struct drm_bridge *bridge);
+void mxsfb_tvenc_set_standard(struct drm_bridge *bridge,
+			      enum mxsfb_tv_standard standard);
+#else
+static inline bool mxsfb_bridge_is_tvenc(struct drm_bridge *bridge)
+{
+	return false;
+}
+
+static inline void mxsfb_tvenc_set_standard(struct drm_bridge *bridge,
+					    enum mxsfb_tv_standard standard)
+{
+}
+#endif
+
+#endif /* __MXSFB_TVENC_H__ */

