@@ -1032,6 +1056,26 @@ static struct snd_soc_component_driver mxs_codec_driver = {
 /* END MXS-ADC Codec driver */
 
 /* Underlying platform device that registers codec */
+/*
+ * The codec needs the RTC PERSISTENT0 register to release the HP ground.
+ * Get it through the nvmem provider referenced by the "nvmem" phandle;
+ * this defers probing until the RTC has registered it.
+ */
+static int mxs_adc_get_rtc(struct platform_device *pdev,
+			   struct mxs_adc_priv *mxs_adc)
+{
+	struct nvmem_device *nvmem;
+
+	nvmem = devm_nvmem_device_get(&pdev->dev, "rtc");
+	if (IS_ERR(nvmem))
+		return dev_err_probe(&pdev->dev, PTR_ERR(nvmem),
+				     "failed to get RTC nvmem\n");
+
+	mxs_adc->rtc_nvmem = nvmem;
+	mutex_init(&mxs_adc->rtc_lock);
+	return 0;
+}
+
 static int mxs_adc_probe(struct platform_device *pdev)
 {
 	struct mxs_adc_priv *mxs_adc;
