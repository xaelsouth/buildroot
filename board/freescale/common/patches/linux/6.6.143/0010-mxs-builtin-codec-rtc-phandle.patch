+/*
+ * The RTC nvmem provider only exposes plain PERSISTENT0 reads and writes, so
+ * the SET/CLR registers are emulated with a locked read-modify-write.
+ */
+static void mxs_adc_rtc_pers0_update(struct mxs_adc_priv *mxs_adc, u32 mask,
+				     bool set)
+{
+	u32 val;
+	int ret;
+
+	mutex_lock(&mxs_adc->rtc_lock);
+	ret = nvmem_device_read(mxs_adc->rtc_nvmem, HW_RTC_PERSISTENT0,
+				sizeof(val), &val);
+	if (ret >= 0) {
+		if (set)
+			val |= mask;
+		else
+			val &= ~mask;
+		ret = nvmem_device_write(mxs_adc->rtc_nvmem,
+					 HW_RTC_PERSISTENT0, sizeof(val), &val);
+	}
+	mutex_unlock(&mxs_adc->rtc_lock);
+	if (ret < 0)
+		pr_warn("mxs-builtin-codec: RTC PERSISTENT0 update failed: %d\n",
+			ret);
+}
