+# SPDX-License-Identifier: (GPL-2.0 OR BSD-2-Clause)
+
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/media/fsl,imx23-pxp.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Freescale i.MX23 Pixel Pipeline
+
+maintainers:
+  - Linux i.MX23 maintainers <linux-arm-kernel@lists.infradead.org>
+
+description:
+  The Pixel Pipeline (PXP) of the i.MX23 is a memory-to-memory engine that
+  supports scaling, colorspace conversion, flipping and rotation. It is an
+  older design than the PXP found on i.MX6UL and later SoCs.
+
+properties:
+  compatible:
+    const: fsl,imx23-pxp
+
+  reg:
+    maxItems: 1
+
+  interrupts:
+    maxItems: 1
+
+required:
+  - compatible
+  - reg
+  - interrupts
+
+additionalProperties: false
+
+examples:
+  - |
+    pxp@8002a000 {
+        compatible = "fsl,imx23-pxp";
+        reg = <0x8002a000 0x2000>;
+        interrupts = <57>;
+    };
