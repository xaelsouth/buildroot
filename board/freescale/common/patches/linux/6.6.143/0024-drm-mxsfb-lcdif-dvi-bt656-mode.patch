+/*
+ * The pixel divider is fed from the 24 MHz crystal by default and cannot
+ * reach 27 MHz, so switch its mux to ref_pix and run that at 10x the rate.
+ */
+static void mxsfb_set_dvi_clock(struct mxsfb_drm_private *mxsfb,
+				unsigned long rate)
+{
+	struct clk *sel = clk_get_parent(clk_get_parent(mxsfb->clk));
+	int ret;
+
+	if (mxsfb->clk_ref_pix && sel) {
+		ret = clk_set_rate(mxsfb->clk_ref_pix, rate * 10);
+		if (!ret)
+			ret = clk_set_parent(sel, mxsfb->clk_ref_pix);
+		if (ret)
+			dev_warn(mxsfb->drm->dev, "Failed to select ref_pix: %d\n", ret);
+	}
+
+	clk_set_rate(mxsfb->clk, rate);
+}
+
+struct mxsfb_dvi_timing {
+	u16 h_blanking;
+	u16 v_lines;
+	u16 f1_start, f1_end, f2_start, f2_end;
+	u16 v1_blank_start, v1_blank_end, v2_blank_start, v2_blank_end;
+};
+
+/* ITU-R BT.656 timing, i.MX23 reference manual chapter 19.3 */
+static const struct mxsfb_dvi_timing mxsfb_dvi_ntsc = {
+	.h_blanking = 262, .v_lines = 525,
+	.f1_start = 4, .f1_end = 265, .f2_start = 266, .f2_end = 3,
+	.v1_blank_start = 263, .v1_blank_end = 285,
+	.v2_blank_start = 1, .v2_blank_end = 22,
+};
+
+static const struct mxsfb_dvi_timing mxsfb_dvi_pal = {
+	.h_blanking = 274, .v_lines = 625,
+	.f1_start = 1, .f1_end = 312, .f2_start = 313, .f2_end = 625,
+	.v1_blank_start = 311, .v1_blank_end = 332,
+	.v2_blank_start = 624, .v2_blank_end = 19,
+};
+
+static void mxsfb_set_dvi_mode(struct mxsfb_drm_private *mxsfb)
+{
+	struct drm_display_mode *m = &mxsfb->crtc.state->adjusted_mode;
+	const struct mxsfb_dvi_timing *t;
+	void __iomem *base = mxsfb->base;
+
+	t = m->vdisplay == 576 ? &mxsfb_dvi_pal : &mxsfb_dvi_ntsc;
+
+	writel(TRANSFER_COUNT_SET_VCOUNT(m->vdisplay) |
+	       TRANSFER_COUNT_SET_HCOUNT(m->hdisplay),
+	       base + mxsfb->devdata->transfer_count);
+
+	/* Two bytes (Cb/Cr and Y) per pixel */
+	writel(DVICTRL0_H_ACTIVE_CNT(m->hdisplay * 2) |
+	       DVICTRL0_H_BLANKING_CNT(t->h_blanking) |
+	       DVICTRL0_V_LINES_CNT(t->v_lines), base + LCDC_V3_DVICTRL0);
+	writel(DVICTRL1_F1_START_LINE(t->f1_start) |
+	       DVICTRL1_F1_END_LINE(t->f1_end) |
+	       DVICTRL1_F2_START_LINE(t->f2_start), base + LCDC_V3_DVICTRL1);
+	writel(DVICTRL2_F2_END_LINE(t->f2_end) |
+	       DVICTRL2_V1_BLANK_START_LINE(t->v1_blank_start) |
+	       DVICTRL2_V1_BLANK_END_LINE(t->v1_blank_end),
+	       base + LCDC_V3_DVICTRL2);
+	writel(DVICTRL3_V2_BLANK_START_LINE(t->v2_blank_start) |
+	       DVICTRL3_V2_BLANK_END_LINE(t->v2_blank_end),
+	       base + LCDC_V3_DVICTRL3);
+	writel(DVICTRL4_Y_FILL_VALUE(16) | DVICTRL4_CB_FILL_VALUE(128) |
+	       DVICTRL4_CR_FILL_VALUE(128), base + LCDC_V3_DVICTRL4);
+
+	/* BT.601 limited range RGB to YCbCr, co-sited chroma subsampling */
+	writel(CSC_COEFF0_C0(0x41) | CSC_COEFF0_SUBSAMPLE_COSITED,
+	       base + LCDC_V3_CSC_COEFF0);
+	writel(CSC_COEFF_PAIR(0x19, 0x81), base + LCDC_V3_CSC_COEFF1);
+	writel(CSC_COEFF_PAIR(0x3b6, 0x3db), base + LCDC_V3_CSC_COEFF2);
+	writel(CSC_COEFF_PAIR(0x70, 0x70), base + LCDC_V3_CSC_COEFF3);
+	writel(CSC_COEFF_PAIR(0x3ee, 0x3a2), base + LCDC_V3_CSC_COEFF4);
+	writel(CSC_OFFSET(128, 16), base + LCDC_V3_CSC_OFFSET);
+	writel(CSC_LIMIT(16, 240, 16, 235), base + LCDC_V3_CSC_LIMIT);
+}
