+static int mxs_trigger(struct snd_pcm_substream *substream,
+						int cmd,
+						struct snd_soc_dai *cpu_dai)
+{
+	struct mxs_adc_priv *mxs_adc = snd_soc_dai_get_drvdata(cpu_dai);
+	struct dma_chan *chan = snd_dmaengine_pcm_get_chan(substream);
+	int playback = substream->stream == SNDRV_PCM_STREAM_PLAYBACK ? 1 : 0;
+	int ret = 0;
+
+	switch (cmd) {
+	case SNDRV_PCM_TRIGGER_START:
+		dev_dbg(mxs_adc->dev, "SNDRV_PCM_TRIGGER_START\n");
+		mxs_trigger_start(playback, mxs_adc);
+		break;
+
+	case SNDRV_PCM_TRIGGER_RESUME:
+		dev_dbg(mxs_adc->dev, "SNDRV_PCM_TRIGGER_RESUME\n");
+		dmaengine_resume(chan);
+		mxs_trigger_start(playback, mxs_adc);
+		break;
+
+	case SNDRV_PCM_TRIGGER_PAUSE_RELEASE:
+		dev_dbg(mxs_adc->dev, "SNDRV_PCM_TRIGGER_PAUSE_RELEASE\n");
+		dmaengine_resume(chan);
+		mxs_trigger_start(playback, mxs_adc);
+		break;
+
+	case SNDRV_PCM_TRIGGER_STOP:
+		dev_dbg(mxs_adc->dev, "SNDRV_PCM_TRIGGER_STOP\n");
+		dmaengine_terminate_async(chan);
+		mxs_trigger_stop(playback, mxs_adc);
+		break;
+
+	case SNDRV_PCM_TRIGGER_SUSPEND:
+		dev_dbg(mxs_adc->dev, "SNDRV_PCM_TRIGGER_SUSPEND\n");
+		dmaengine_pause(chan);
+		mxs_trigger_stop(playback, mxs_adc);
+		if (playback) {
+				__raw_writel(BM_AUDIOOUT_CTRL_FIFO_UNDERFLOW_IRQ |
+							 BM_AUDIOOUT_CTRL_FIFO_OVERFLOW_IRQ |
+							 BM_AUDIOOUT_CTRL_FIFO_ERROR_IRQ_EN |
+							 BM_AUDIOOUT_CTRL_RUN,
+					mxs_adc->audioout_base + HW_AUDIOOUT_CTRL_CLR);
+		}
+		break;
+
+	case SNDRV_PCM_TRIGGER_PAUSE_PUSH:
+		dev_dbg(mxs_adc->dev, "SNDRV_PCM_TRIGGER_PAUSE_PUSH\n");
+		dmaengine_pause(chan);
+		mxs_trigger_stop(playback, mxs_adc);
+		if (playback) {
+				__raw_writel(BM_AUDIOOUT_CTRL_FIFO_UNDERFLOW_IRQ |
+							 BM_AUDIOOUT_CTRL_FIFO_OVERFLOW_IRQ |
+							 BM_AUDIOOUT_CTRL_FIFO_ERROR_IRQ_EN |
+							 BM_AUDIOOUT_CTRL_RUN,
+					mxs_adc->audioout_base + HW_AUDIOOUT_CTRL_CLR);
 		}
 		break;
 
