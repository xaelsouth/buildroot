+#define MXS_ADC_PHASE_TAPS	16
+#define MXS_ADC_PHASE_DELAY	((MXS_ADC_PHASE_TAPS / 2) - 1)
+
+/* Errata 2798 compensation state (capture only) */
+struct mxs_adc_phase {
+	bool reset;
+	unsigned int lead;		/* 0 = off, 1 = left leads, 2 = right leads */
+	unsigned int pos;
+	s32 lead_hist[MXS_ADC_PHASE_TAPS];
+	s32 lag_hist[MXS_ADC_PHASE_TAPS];
+};
+
 struct mxs_adc_priv {
+	struct mxs_adc_phase adc_phase;
 	struct mxs_irq_data adc_err_irq_data;
 	struct mxs_irq_data dac_err_irq_data;
 	int dma_adc_err_irq;
@@ -43,6 +56,9 @@ struct mxs_adc_priv {
 	u32 unknown_error;
 };
 
+struct snd_pcm_substream;
+void mxs_adc_phase_start(struct mxs_adc_priv *mxs_adc);
+int mxs_adc_pcm_startup(struct snd_pcm_substream *substream);
 int mxs_adc_pcm_platform_register(struct device *dev);
 void mxs_adc_pcm_platform_unregister(struct device *dev);
 
