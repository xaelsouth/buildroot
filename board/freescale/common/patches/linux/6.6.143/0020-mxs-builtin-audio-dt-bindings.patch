+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/sound/fsl,imx23-audio-block.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Freescale i.MX23 AUDIOOUT and AUDIOIN register blocks
+
+maintainers:
+  - Michal Ulianko <michal.ulianko@gmail.com>
+
+description:
+  The AUDIOOUT (DAC and headphone amplifier) and AUDIOIN (ADC) blocks of the
+  i.MX23. Registers are shared between the built-in codec driver and the
+  built-in CPU DAI driver, which both reach them through a syscon regmap.
+  The error interrupts belong to these blocks, so they are described here
+  and not on the sound nodes.
+
+select:
+  properties:
+    compatible:
+      contains:
+        enum:
+          - fsl,imx23-audioin
+          - fsl,imx23-audioout
+  required:
+    - compatible
+
+properties:
+  compatible:
+    items:
+      - enum:
+          - fsl,imx23-audioin
+          - fsl,imx23-audioout
+      - const: syscon
+
+  reg:
+    maxItems: 1
+
+  interrupts:
+    minItems: 1
+    maxItems: 2
+
+  interrupt-names:
+    minItems: 1
+    maxItems: 2
+
+required:
+  - compatible
+  - reg
+  - interrupts
+  - interrupt-names
+
+allOf:
+  - if:
+      properties:
+        compatible:
+          contains:
+            const: fsl,imx23-audioout
+    then:
+      properties:
+        interrupts:
+          minItems: 2
+        interrupt-names:
+          items:
+            - const: dac-error
+            - const: hp-short
+    else:
+      properties:
+        interrupts:
+          maxItems: 1
+        interrupt-names:
+          items:
+            - const: adc-error
+
+additionalProperties: false
+
+examples:
+  - |
+    audio-out@80048000 {
+        compatible = "fsl,imx23-audioout", "syscon";
+        reg = <0x80048000 0x2000>;
+        interrupts = <6>, <4>;
+        interrupt-names = "dac-error", "hp-short";
+    };
+
+    audio-in@8004c000 {
+        compatible = "fsl,imx23-audioin", "syscon";
+        reg = <0x8004c000 0x2000>;
+        interrupts = <8>;
+        interrupt-names = "adc-error";
+    };
diff --git a/Documentation/devicetree/bindings/sound/fsl,mxs-builtin-cpu-dai.yaml b/Documentation/devicetree/bindings/sound/fsl,mxs-builtin-cpu-dai.yaml
