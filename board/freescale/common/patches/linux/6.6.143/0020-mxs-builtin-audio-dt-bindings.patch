@@ -0,0 +1,66 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/sound/fsl,mxs-builtin-cpu-dai.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Freescale i.MX23 built-in audio CPU DAI
+
+maintainers:
+  - Michal Ulianko <michal.ulianko@gmail.com>
+
+description:
+  CPU DAI and DMA PCM of the i.MX23 built-in codec. It has no register range
+  of its own: it drives the AUDIOOUT and AUDIOIN blocks through their syscon
+  regmaps, takes the error interrupts from them and uses one APBX DMA channel
+  for each direction.
+
+allOf:
+  - $ref: dai-common.yaml#
+
+properties:
+  compatible:
+    const: fsl,mxs-builtin-cpu-dai
+
+  '#sound-dai-cells':
+    const: 0
+
+  fsl,audio-out:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description:
+      AUDIOOUT block. Provides the DAC registers, the DAC error and the
+      headphone short interrupts.
+
+  fsl,audio-in:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description:
+      AUDIOIN block. Provides the ADC registers and the ADC error interrupt.
+
+  dmas:
+    maxItems: 2
+
+  dma-names:
+    items:
+      - const: rx
+      - const: tx
+
+required:
+  - compatible
+  - '#sound-dai-cells'
+  - fsl,audio-out
+  - fsl,audio-in
+  - dmas
+  - dma-names
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    audio-controller {
+        compatible = "fsl,mxs-builtin-cpu-dai";
+        #sound-dai-cells = <0>;
+        fsl,audio-out = <&audio_out>;
+        fsl,audio-in = <&audio_in>;
+        dmas = <&dma_apbx 0>, <&dma_apbx 1>;
+        dma-names = "rx", "tx";
+    };
