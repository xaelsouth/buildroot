+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/sound/fsl,mxs-builtin-codec.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Freescale i.MX23 built-in audio codec
+
+maintainers:
+  - Michal Ulianko <michal.ulianko@gmail.com>
+
+description:
+  DAC, ADC and headphone amplifier of the i.MX23. The registers are reached
+  through the syscon regmaps of the AUDIOOUT and AUDIOIN blocks. A bit of the
+  RTC PERSISTENT0 register must be set to release the headphone ground, which
+  is done through the nvmem provider of the RTC.
+
+allOf:
+  - $ref: dai-common.yaml#
+
+properties:
+  compatible:
+    const: fsl,mxs-builtin-codec
+
+  '#sound-dai-cells':
+    const: 0
+
+  fsl,audio-out:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description: AUDIOOUT block, see fsl,imx23-audio-block.yaml.
+
+  fsl,audio-in:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description: AUDIOIN block, see fsl,imx23-audio-block.yaml.
+
+  clocks:
+    maxItems: 1
+
+  clock-names:
+    const: filt
+
+  nvmem:
+    $ref: /schemas/types.yaml#/definitions/phandle-array
+    maxItems: 1
+    description: RTC nvmem provider holding PERSISTENT0.
+
+  nvmem-names:
+    const: rtc
+
+required:
+  - compatible
+  - '#sound-dai-cells'
+  - fsl,audio-out
+  - fsl,audio-in
+  - clocks
+  - clock-names
+  - nvmem
+  - nvmem-names
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/clock/imx23-clock.h>
+
+    audio-codec {
+        compatible = "fsl,mxs-builtin-codec";
+        #sound-dai-cells = <0>;
+        fsl,audio-out = <&audio_out>;
+        fsl,audio-in = <&audio_in>;
+        clocks = <&clks IMX23_CLK_FILT>;
+        clock-names = "filt";
+        nvmem = <&rtc>;
+        nvmem-names = "rtc";
+    };
