From: <xael.south@yandex.com>
Subject: [PATCH] ASoC: mxs: clear playback DMA buffer on prepare

Clear the built-in codec playback buffer to format-correct silence while
the PCM stream is prepared, before playback DMA starts.

---
diff --git a/sound/soc/mxs/mxs-builtin-dai.c b/sound/soc/mxs/mxs-builtin-dai.c
--- a/sound/soc/mxs/mxs-builtin-dai.c
+++ b/sound/soc/mxs/mxs-builtin-dai.c
@@ -485,11 +485,32 @@ static void mxs_shutdown(struct snd_pcm_substream *substream,
 	}
 }
 
+static int mxs_prepare(struct snd_pcm_substream *substream,
+		       struct snd_soc_dai *cpu_dai)
+{
+	struct snd_pcm_runtime *runtime = substream->runtime;
+	ssize_t samples;
+	int ret;
+
+	if (substream->stream != SNDRV_PCM_STREAM_PLAYBACK)
+		return 0;
+
+	samples = bytes_to_samples(runtime,
+				   frames_to_bytes(runtime, runtime->buffer_size));
+	ret = snd_pcm_format_set_silence(runtime->format, runtime->dma_area,
+					 samples);
+	if (ret < 0)
+		dev_err(cpu_dai->dev, "failed to clear playback buffer: %d\n", ret);
+
+	return ret;
+}
+
 static const struct snd_soc_dai_ops mxs_adc_dai_ops = {
 	.probe = mxs_dai_probe,
 	.startup = mxs_startup,
 	.trigger = mxs_trigger,
 	.shutdown = mxs_shutdown,
+	.prepare = mxs_prepare,
 };
 
 static int mxs_dai_probe(struct snd_soc_dai *dai)
