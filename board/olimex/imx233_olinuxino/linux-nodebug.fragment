# Kernel 6.6.143 no-debug fragment
# EXPERT is required to be able to disable KALLSYMS and friends; it selects DEBUG_KERNEL, which is harmless on its own
CONFIG_EXPERT=y
# CONFIG_PROVE_LOCKING is not set
CONFIG_DEBUG_INFO_NONE=y
# CONFIG_DEBUG_FS is not set
# CONFIG_BLK_DEBUG_FS is not set
# CONFIG_BLK_DEV_IO_TRACE is not set
# CONFIG_DEBUG_MISC is not set
# CONFIG_DEBUG_USER is not set
# CONFIG_DEBUG_BUGVERBOSE is not set
# CONFIG_DEBUG_MEMORY_INIT is not set
# CONFIG_DEBUG_LOCK_ALLOC is not set
# CONFIG_DEBUG_MUTEXES is not set
# CONFIG_DEBUG_RT_MUTEXES is not set
# CONFIG_DEBUG_RWSEMS is not set
# CONFIG_DEBUG_SPINLOCK is not set
# CONFIG_DEBUG_WW_MUTEX_SLOWPATH is not set
# CONFIG_SCHED_DEBUG is not set
# CONFIG_SCHED_INFO is not set
# CONFIG_SLUB_DEBUG is not set
# CONFIG_LOCKUP_DETECTOR is not set
# CONFIG_SOFTLOCKUP_DETECTOR is not set
# CONFIG_TRACE_IRQFLAGS is not set
# CONFIG_FTRACE is not set
# CONFIG_MAGIC_SYSRQ is not set
# CONFIG_KALLSYMS is not set
# CONFIG_KALLSYMS_ALL is not set
# CONFIG_PRINTK_TIME is not set
# CONFIG_JFFS2_FS_DEBUG is not set
