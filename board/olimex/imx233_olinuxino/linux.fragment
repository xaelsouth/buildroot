# CPU frequency and VDDD voltage scaling
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_STAT=y
CONFIG_CPU_FREQ_DEFAULT_GOV_ONDEMAND=y
CONFIG_CPU_FREQ_GOV_ONDEMAND=y
CONFIG_CPUFREQ_DT=y
CONFIG_REGULATOR_MXS_VDDD=y
# MOD-ENC624J600 Ethernet on UEXT (SPI)
CONFIG_ENCX24J600=y
CONFIG_DRM_FBDEV_OVERALLOC=200
CONFIG_MEDIA_SUPPORT=y
CONFIG_MEDIA_SUPPORT_FILTER=y
# CONFIG_MEDIA_DIGITAL_TV_SUPPORT is not set
# CONFIG_MEDIA_ANALOG_TV_SUPPORT is not set
# CONFIG_MEDIA_RADIO_SUPPORT is not set
# CONFIG_MEDIA_SDR_SUPPORT is not set
# CONFIG_MEDIA_TEST_SUPPORT is not set
CONFIG_MEDIA_PLATFORM_SUPPORT=y
CONFIG_V4L_MEM2MEM_DRIVERS=y
CONFIG_VIDEO_IMX23_PXP=y
CONFIG_CMA=y
CONFIG_DMA_CMA=y
CONFIG_CMA_SIZE_MBYTES=16
# Composite TV output through the i.MX23 TV encoder
CONFIG_DRM_MXSFB_TVENC=y
CONFIG_CMDLINE_EXTEND=y
#CONFIG_CMDLINE="mxsfb.output=tv_pal"
CONFIG_CMDLINE="mxsfb.output=tv_ntsc"
